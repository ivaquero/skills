  "grammar_points": {
    "adj_adv": {
      "id": "adj_adv",
      "label": "形容词与副词",
      "children": [
        {
          "id": "adj_agreement",
          "label": "性数一致与位置（后置定语；前置义变 un gran hombre / un hombre grande）"
        },
        {
          "id": "adj_short_forms",
          "label": "短尾形式（buen / mal / primer / tercer / algún / ningún / cien）"
        },
        {
          "id": "adj_comparative",
          "label": "比较级（más / menos…que、tan…como；不规则 mejor / peor / mayor / menor）"
        },
        {
          "id": "adj_superlative",
          "label": "最高级（el / la más…de；绝对最高级 -ísimo）"
        },
        {
          "id": "adj_diminutives",
          "label": "指小与指大词（-ito / -illo；-ón / -ote / -azo）"
        },
        {
          "id": "adv_degree",
          "label": "副词与程度修饰（muy / mucho / tan / tanto；-mente；ya / todavía）"
        }
      ]
    },
    "indicativo": {
      "id": "indicativo",
      "label": "直陈式动词系统",
      "children": [
        {
          "id": "ind_presente",
          "label": "现在时（e→ie / o→ue / e→i 词干变化；不规则第一人称）"
        },
        {
          "id": "ind_perfecto",
          "label": "现在完成时（he + participio；ya / todavía no / alguna vez）"
        },
        {
          "id": "ind_indefinido",
          "label": "简单过去时（重音规则；-uv- / -i- / -j- 不规则组）"
        },
        {
          "id": "ind_imperfecto",
          "label": "未完成过去时（描写与习惯；与 indefinido 的叙事分工）"
        },
        {
          "id": "ind_pluscuamperfecto",
          "label": "过去完成时（había + participio；叙事中的「更早」）"
        },
        {
          "id": "ind_futuro",
          "label": "将来时（futuro simple 不规则词干；ir a + infinitivo）"
        }
      ]
    },
    "pronombres": {
      "id": "pronombres",
      "label": "代词系统",
      "children": [
        {
          "id": "pro_sujeto",
          "label": "主语代词与省略（零主语；vosotros / ustedes；voseo）"
        },
        {
          "id": "pro_od",
          "label": "直接宾语代词（lo / la / los / las；leísmo / laísmo / loísmo）"
        },
        {
          "id": "pro_oi",
          "label": "间接宾语与冗余 le（le / les 与 a + 名词必须共现）"
        },
        {
          "id": "pro_double_order",
          "label": "双代词顺序（le / les → se + lo / la；代词与动词的位次）"
        },
        {
          "id": "pro_se",
          "label": "se 的多重用法（自复 / 相互 / 无人称 / 被动 / 意外）"
        },
        {
          "id": "pro_posesivos",
          "label": "物主与夺格（su 歧义；mío / tuyo；conmigo / contigo / consigo）"
        }
      ]
    },
    "relativas_conj": {
      "id": "relativas_conj",
      "label": "关系从句与连词",
      "children": [
        {
          "id": "rel_pronouns",
          "label": "关系代词（que / quien / el que / el cual）"
        },
        {
          "id": "rel_cuyo",
          "label": "所有格关系词（cuyo / cuya / cuyos / cuyas）"
        },
        {
          "id": "rel_adverb",
          "label": "关系副词（donde / cuando / como；el que + 介词 对应法语 dont）"
        },
        {
          "id": "conj_coord",
          "label": "并列连词（y → e / o → u；pero vs sino；ni…ni）"
        },
        {
          "id": "conj_subord",
          "label": "从属连词（porque / ya que / así que / cuando / en cuanto）"
        },
        {
          "id": "conj_concesiva",
          "label": "让步与条件（aunque + 直陈 / 虚拟；a pesar de；si / a menos que / siempre que）"
        }
      ]
    },
    "modos": {
      "id": "modos",
      "label": "语式系统（虚拟式 · 条件式 · 命令式）",
      "children": [
        {
          "id": "mode_condicional",
          "label": "条件式（礼貌请求 / 假设 / 传闻；不规则词干同 futuro）"
        },
        {
          "id": "mode_si",
          "label": "Si 三搭配（现在 + 将来 / 过去未完成 + 条件式 / 过去完成 + 条件式完成）"
        },
        {
          "id": "mode_subj_presente",
          "label": "虚拟式现在时（-ar → -e 系 / -er·-ir → -a 系；dar / estar / haber / ir / saber / ser）"
        },
        {
          "id": "mode_subj_pasado",
          "label": "虚拟式过去时与时态配合（-ra / -se 等价；主句过去 → 从句过去虚拟）"
        },
        {
          "id": "mode_subj_triggers",
          "label": "虚拟式触发 7 类 + 直陈 / 虚拟边界（愿望 / 必要 / 情感 / 怀疑 / 目的 / 让步 / 时间将来；aunque / ojalá / quizás）"
        },
        {
          "id": "mode_imperativo",
          "label": "命令式（肯定式不规则 tú / vosotros；否定式借虚拟式；代词后置）"
        }
      ]
    },
    "no_finitas_pasiva": {
      "id": "no_finitas_pasiva",
      "label": "非谓语与被动态",
      "children": [
        {
          "id": "nf_infinitivo",
          "label": "不定式结构（ir a / tener que / hay que / acabar de / volver a / al + 不定式）"
        },
        {
          "id": "nf_gerundio",
          "label": "gerundio（estar + gerundio 进行；seguir / llevar / quedarse + gerundio）"
        },
        {
          "id": "nf_participio",
          "label": "过去分词（规则 -ado / -ido；不规则 hecho / dicho / visto；与 haber / ser / estar 配合）"
        },
        {
          "id": "pasiva_ser_estar",
          "label": "被动与状态（ser + 分词全时态 + por；estar + 分词的结果义）"
        },
        {
          "id": "pasiva_se",
          "label": "se 被动与无人称（se vende / se habla / se dice que；第三人称复数无人称）"
        }
      ]
    },
    "fragmentos": {
      "id": "fragmentos",
      "label": "常用碎片语法点（可单独勾选：跨章节组合 + 零散辨析）",
      "children": [
        {
          "id": "frag_pasados",
          "label": "过去时组（indefinido · imperfecto · pluscuamperfecto）"
        },
        {
          "id": "frag_modos",
          "label": "语式组（虚拟式 · 命令式 · 条件式）"
        },
        {
          "id": "frag_objeto",
          "label": "宾格组（lo / le / se lo · 人称 a）"
        },
        {
          "id": "frag_ser_estar",
          "label": "ser vs estar（性质 / 状态 / 位置；形容词义变）"
        },
        {
          "id": "frag_por_para",
          "label": "por vs para（原因 / 目的 / 交换 / 期限）"
        },
        {
          "id": "frag_interrog",
          "label": "疑问词与疑问句（qué / cuál / cómo / dónde；语序与倒问号）"
        },
        {
          "id": "frag_num",
          "label": "数字与量词（cien / ciento；muy vs mucho；比例与数量）"
        }
      ]
    }
