<mxfile host="drawio2vsdx-selfcheck" agent="standard-library" version="1">
  <diagram id="demo" name="Page-1">
    <mxGraphModel dx="900" dy="500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="center" value="中心概念" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=12;fillColor=#F0F0F0;strokeColor=#B1B1B1;" vertex="1" parent="1">
          <mxGeometry x="370" y="210" width="160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="capsule" value="圆角做法" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="160" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="cylinder" value="官方手册" style="shape=cylinder3;boundedLbl=1;size=22;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=10;fillColor=#F0F0F0;strokeColor=#B1B1B1;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="170" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="document" value="示例案例&lt;br&gt;第二行" style="shape=mxgraph.flowchart.document;size=0.16;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=10;fillColor=#FFFFFF;strokeColor=#BFA9C8;" vertex="1" parent="1">
          <mxGeometry x="650" y="200" width="160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="rect" value="知识点" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="100" width="140" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="内容包含" style="endArrow=block;fontSize=9;strokeColor=#666666;" edge="1" parent="1" source="center" target="rect">
          <mxGeometry relative="1" x="0.62" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="支持" style="endArrow=block;fontSize=9;strokeColor=#666666;" edge="1" parent="1" source="rect" target="document">
          <mxGeometry relative="1" x="0.45" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="包含" style="endArrow=block;fontSize=9;strokeColor=#666666;" edge="1" parent="1" source="center" target="capsule">
          <mxGeometry relative="1" x="0.58" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=none;fontSize=9;strokeColor=#666666;" edge="1" parent="1" source="center" target="cylinder">
